GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Main model (Claude on Bedrock). Leave empty to use only Groq.
# Needs real AWS credentials with Bedrock access (the "test" keys below are only for local S3).
BEDROCK_MODEL_ID=

# PostgreSQL: local server on this machine. For Aiven set the Aiven host/port/user/password and DB_SSLMODE=require.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=documind
DB_SSLMODE=disable

# S3 - the local LocalStack container from docker-compose.yml
S3_BUCKET_NAME=documind-documents-local
AWS_REGION=ap-south-1
LOCAL_AWS_ENDPOINT=http://localhost:4567
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
