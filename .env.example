GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Main model (Claude on Bedrock). Leave empty to use only Groq.
# Needs real AWS credentials with Bedrock access (the "test" keys below are only for LocalStack S3).
BEDROCK_MODEL_ID=

# MySQL - the same database as the Node API (see ../api/.env)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=documind

# S3 - locally this is the Node API's LocalStack (npm run localstack:up in ../api)
S3_BUCKET_NAME=documind-documents-local
AWS_REGION=ap-south-1
LOCAL_AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
